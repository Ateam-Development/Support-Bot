rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Conversations: Accessible by authenticated users
    match /conversations/{conversationId} {
      allow read, write: if request.auth != null;
    }
    
    // Chatbots: Accessible by authenticated users
    match /chatbots/{chatbotId} {
      allow read, write: if request.auth != null;
    }

    // Knowledge & Knowledge Chunks
    match /knowledge/{knowledgeId} {
      allow read, write: if request.auth != null;
    }
    match /knowledge_chunks/{chunkId} {
      allow read, write: if request.auth != null;
    }

    // Sections: Accessible by authenticated users
    match /sections/{sectionId} {
      allow read, write: if request.auth != null;
    }

    // User accounts: Restricted to doc owner
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Public messages (e.g. contact form submissions)
    match /messages/{messageId} {
      allow create: if true;
      allow read, update, delete: if false;
    }
  }
}
